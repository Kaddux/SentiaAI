# Copy to .env and fill in real values.

# PostgreSQL
POSTGRES_DB=health_assistant
POSTGRES_USER=health_user
POSTGRES_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-to-a-long-random-string # MUST be the same in all services

# LLM provider: "nvidia" (default) | "ollama" | "deepseek"
LLM_PROVIDER=nvidia
# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible. Free credits on signup.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
# Optional local/Ollama (re-enable by setting LLM_PROVIDER=ollama)
LLM_FALLBACK_PROVIDER=deepseek
OLLAMA_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b
# DeepSeek (optional alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
