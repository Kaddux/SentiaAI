# Copy to .env and fill in real values

# PostgreSQL connection (asyncpg driver). Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://health_user:change-me@postgres:5432/health_assistant

# LLM provider: "nvidia" (default) | "ollama" | "deepseek"
LLM_PROVIDER=nvidia
# NVIDIA NIM (build.nvidia.com) — OpenAI-compatible. Free credits on signup.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=openai/gpt-oss-20b
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1024

# Optional local/Ollama (re-enable by setting LLM_PROVIDER=ollama)
LLM_FALLBACK_PROVIDER=deepseek
OLLAMA_BASE_URL=http://ollama:11434/v1
LLM_MODEL=qwen3:8b

# DeepSeek (optional alternative)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Backend / ML service URLs (compose service names)
BACKEND_URL=http://backend:8080
ML_SERVICE_URL=http://ml-service:8001

# Shared with backend for token verification (must be >= 32 bytes)
JWT_SECRET=change-me-to-a-long-random-string
